# Copy to .env and edit. Every variable below is read by app.py; relative
# paths are resolved against the repository root, not the current directory.

# SECRET_KEY signs the session cookie. Do NOT copy the line below verbatim --
# a shared, publicly-known key lets anyone forge a login session (app.py
# ignores this placeholder and falls back to a random per-process key).
# Generate your own and paste the result here:
#
#   python -c "import secrets; print(secrets.token_hex(32))"
#
SECRET_KEY=CHANGE_ME_RUN_THE_COMMAND_ABOVE

# Server
FLASK_DEBUG=0                          # 1 enables Werkzeug's interactive debugger. NEVER set to 1 on a reachable host.
FLASK_HOST=127.0.0.1                   # Set to 0.0.0.0 to expose on your LAN
FLASK_PORT=5000

# Paths
DATABASE_PATH=csgo_items.db            # SQLite file holding items, users and journals
MODEL_PATH=Models/BOX_TRAINED.pt       # YOLO weights for the drop-panel detector
UPLOAD_FOLDER=uploads                  # Uploaded screenshots (files older than 1 hour are deleted)
MAX_UPLOAD_MB=20                       # Largest accepted upload/paste; a 4K PNG screenshot is ~10 MB
PRICE_UPDATE_CONFIG=price_update_config.json   # Collections/limits for the daily price job

# History weeks: cs2 = from one weekly care-package reset to the next
# (Wednesday CS2_RESET_HOUR_UTC:00 UTC), iso = Monday 00:00 UTC
WEEK_BOUNDARY=cs2
CS2_RESET_HOUR_UTC=1                   # Trackers give Wed 01:00 GMT; set 2 if it moves in winter

# Recommendations
VALUATION_RULE=lowest                  # How a skin of unknown wear is valued: lowest | median | highest (README "How items are valued")
PRICE_STALE_HOURS=48                   # Warn on the results page when the newest price is older than this

# Sessions
SESSION_LIFETIME_DAYS=120              # Lifetime of a "remember me" login (otherwise 1 hour)
SESSION_COOKIE_SECURE=False            # Set True ONLY when serving over HTTPS -- True on plain HTTP silently breaks login

# Reverse proxies in front of the app (nginx, Caddy, ...). 0 = none: the
# X-Forwarded-* headers are ignored, so clients cannot spoof their address.
# Set to the number of proxies so the login throttle sees real client IPs.
TRUSTED_PROXIES=0

# Login throttling (per client IP, or per /64 for IPv6; in memory)
LOGIN_MAX_ATTEMPTS=5                   # Failed logins allowed per window; 0 disables the lockout
LOGIN_LOCKOUT_MINUTES=15               # Window length, and how long a locked-out client waits

# CSRF tokens on every form POST. Leave on; 0 only for debugging a client.
CSRF_ENABLED=1

# Logging: DEBUG, INFO, WARNING or ERROR (to stderr, under python app.py,
# flask run or a WSGI server alike)
LOG_LEVEL=INFO

# Not implemented (listed previously but never read by the code): API rate
# limiting, CORS origins, SESSION_TYPE.
#
# This file is read from next to app.py. To keep it elsewhere, set the real
# environment variable DOTENV_PATH to its path. Variables already set in the
# environment take precedence over this file.
